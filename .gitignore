venv/
pipeline/output/

# --- Node / Vite (web) ---
node_modules/
dist/
.vite/

# --- Terraform (infra) ---
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
crash.log

# --- Firebase ---
.firebase/
firebase-debug.log

