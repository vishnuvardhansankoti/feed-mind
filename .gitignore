# Ignore Python cache
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.env

# Ignore local secrets — never commit these
*.json
*.key
*.pem
service-account*.json

# Ignore IDE files
.vscode/
.idea/
*.swp

# Ignore OS files
.DS_Store
Thumbs.db


.vscode/settings.json

secrets.txt

# uv specific
.uv/
uv.lock

# Test and lint caches
.pytest_cache/
.ruff_cache/
.coverage
