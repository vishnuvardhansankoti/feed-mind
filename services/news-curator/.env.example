# --- Sink: "local" writes JSON to ./output/stories, "firestore" writes to the
# real `stories` collection and updates processed_articles. Only __main__.py
# (the CLI tuning tool) reads this — main.py, the Cloud Run push entrypoint,
# always uses Firestore. See both files' docstrings. ---
SINK=local

# For SINK=firestore (also required to just *read* the real backlog, since
# fetch_pending_articles always talks to Firestore regardless of SINK):
GOOGLE_CLOUD_PROJECT=feed-mind
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# The one Firestore database every FeedMind component shares. Empty -> "(default)".
FIRESTORE_DATABASE=feed-mind-db

# --- Tunables (design doc §4.2, §4.4, §4.6 — defaults match the doc) ---
COARSE_THRESHOLD=0.28
CLUSTER_DISTANCE_THRESHOLD=0.22
TOP_K_PER_CATEGORY=5
