# Non-secret env for the Cloud Run Job. Copy to env.yaml and edit the profiles.
# Deployed via `gcloud run jobs deploy --env-vars-file env.yaml`.
# (The Gemini key is NOT here — it is mounted from Secret Manager.)
# Values must be strings (quoted), because the profiles contain commas/colons.

SINK: "firestore"
GOOGLE_CLOUD_PROJECT: "YOUR_PROJECT_ID"
FIRESTORE_DATABASE: "feed-mind-db"   # named (non-default) database; empty -> "(default)"
# Announced when a run finishes, so feed-mind-summarizer can turn the new papers
# into audio (see events.py). Empty -> no announcement. The topic and this job's
# publisher grant on it are created by the consumer's deploy/setup.sh.
CONTENT_READY_TOPIC: "feedmind-content-ready"
GEMINI_MODEL: "gemini-3.6-flash"
WINDOW_DAYS: "7"
TOP_K: "3"
RETENTION_DAYS: "45"
ARXIV_PAGE_SIZE: "100"
ARXIV_THROTTLE_SECONDS: "3"
ARXIV_MAX_PAGES: "10"

PROFILE_AIML: "Efficient training and inference for large models: KV-cache tricks, quantization, sparsity/MoE, distillation, small models that match big ones, optimization and scaling laws, and reinforcement learning that actually ships."
PROFILE_NLP: "Practical large language models: retrieval-augmented generation, long-context, agents and tool use, evaluation and hallucination, instruction tuning and preference optimization, and generative text systems that are reproducible."
PROFILE_CV: "Generative vision: diffusion and flow models, text-to-image and text-to-video, controllable and 3D-aware generation, efficient samplers, and multimodal models bridging vision and language."
