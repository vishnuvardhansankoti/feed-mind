# Data source: "mock" (bundled JSON fixtures, for local dev) or "firestore".
VITE_DATA_SOURCE=mock

# Firebase web config (public, not secret) — required when VITE_DATA_SOURCE=firestore.
# Copy these from Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
