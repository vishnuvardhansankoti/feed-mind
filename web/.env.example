# Data source: "mock" (bundled JSON fixtures, for local dev) or "firestore".
VITE_DATA_SOURCE=mock

# Firebase web config (public, not secret) — required when VITE_DATA_SOURCE=firestore.
# Copy these from Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Named (non-default) Firestore database to read. Must match the pipeline's
# FIRESTORE_DATABASE. Leave empty to read the "(default)" database.
VITE_FIRESTORE_DATABASE=feed-mind-db

# Google Analytics 4 measurement id ("G-XXXXXXXXXX"). Optional. When empty,
# gtag.js is never loaded and no hits are sent — keep it blank here and in
# .env.local so dev/mock builds don't track; set the real id in .env.prod.
VITE_GA_MEASUREMENT_ID=
